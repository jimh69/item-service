<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="com/example/common/logging/base-appenders.xml"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.example.common.logging.RequestLoggingFilter" level="INFO" additivity="false">
        <appender-ref ref="FILE_REQUESTS" />
        <appender-ref ref="CONSOLE" />
    </logger>

    <logger name="com.example.common.logging.ResponseLoggingFilter" level="INFO" additivity="false">
        <appender-ref ref="FILE_RESPONSES" />
        <appender-ref ref="CONSOLE" />
    </logger>

    <logger name="com.example.itemservice" level="INFO" additivity="false">
        <appender-ref ref="FILE_SERVICE" />
        <appender-ref ref="CONSOLE" />
    </logger>

    <logger name="com.example.itemservice.config" level="DEBUG" additivity="false">
        <appender-ref ref="FILE_SERVICE" />
        <appender-ref ref="CONSOLE" />
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>